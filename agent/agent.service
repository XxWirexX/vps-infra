[Unit]
Description=Agent wireredblue (actions du panel admin)
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=debian
Group=debian
WorkingDirectory=/home/debian/infra/agent
EnvironmentFile=/home/debian/infra/agent/.env
ExecStart=/usr/bin/python3 -u /home/debian/infra/agent/agent.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
